# Manifest — Environment Configuration
# Copy this file to .env.local and fill in your values.

# ─── Network ────────────────────────────────────────────────────────────────
# Midnight network to connect to: preview | preprod | mainnet
NEXT_PUBLIC_NETWORK=preview

# ─── Contract ───────────────────────────────────────────────────────────────
# Deployed contract address (populated by npm run deploy)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Deployer wallet address
NEXT_PUBLIC_DEPLOYER_ADDRESS=

# ─── Proof Server ───────────────────────────────────────────────────────────
# Midnight proof server URL (local Docker or remote)
NEXT_PUBLIC_PROOF_SERVER_URL=http://localhost:6300
